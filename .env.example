# Copy to .env and fill in. Every platform's secrets are read from env vars only.

# --- CognoDB Cloud (free c0) ---
COGNODB_URI=bolt+s://<instance-id>.databases.cognodb.com
COGNODB_USER=cognodb
COGNODB_PASSWORD=

# --- Comparators (filled in as we provision them) ---
NEO4J_URI=bolt://<host>:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=

MEMGRAPH_URI=bolt://<host>:7687
MEMGRAPH_USER=
MEMGRAPH_PASSWORD=

FALKORDB_URI=redis://<host>:6379
FALKORDB_PASSWORD=

ARANGO_URL=http://<host>:8529
ARANGO_USER=root
ARANGO_PASSWORD=
